{
  "name": "dragdoll-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/dragdoll",
    "packages/dragdoll-react",
    "packages/dragdoll-solid",
    "packages/dragdoll-docs",
    "packages/dragdoll-tests",
    "packages/dragdoll-react-tests",
    "packages/dragdoll-solid-tests"
  ],
  "scripts": {
    "build": "npm run format && npm run build --workspace=dragdoll --workspace=dragdoll-react --workspace=dragdoll-solid && npm run build:examples --workspace=dragdoll-docs && npm run format",
    "dev": "npm run docs:dev",
    "docs:build": "npm run build --workspace=dragdoll-docs",
    "docs:dev": "npm run dev --workspace=dragdoll-docs",
    "docs:serve": "npm run serve --workspace=dragdoll-docs",
    "eslint:check": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.mts,.cjs,.cts --max-warnings 0",
    "eslint:write": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.mts,.cjs,.cts --fix",
    "format": "npm run eslint:write && npm run prettier:write",
    "lint": "npm run ts:check && npm run prettier:check && npm run eslint:check",
    "prettier:check": "prettier --check --no-error-on-unmatched-pattern \"./*.{js,ts,md,json,yml}\" \"./.github/**/*.yml\" && npm run prettier:check --workspaces --if-present",
    "prettier:write": "prettier --write --no-error-on-unmatched-pattern \"./*.{js,ts,md,json,yml}\" \"./.github/**/*.yml\" && npm run prettier:write --workspaces --if-present",
    "test:bs": "npm run test:bs --workspace=dragdoll-tests",
    "test:local": "npm run test:local --workspace=dragdoll-tests",
    "test:react:bs": "npm run test:bs --workspace=dragdoll-react-tests",
    "test:react:local": "npm run test:local --workspace=dragdoll-react-tests",
    "test:solid:bs": "npm run test:bs --workspace=dragdoll-solid-tests",
    "test:solid:local": "npm run test:local --workspace=dragdoll-solid-tests",
    "ts:check": "tsc && npm run ts:check --workspaces --if-present"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser-webdriverio": "4.1.2",
    "browserstack-local": "1.5.12",
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.0",
    "esbuild-plugin-solid": "0.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eventti": "4.0.4",
    "globals": "17.4.0",
    "jsdom": "29.0.1",
    "mezr": "1.1.0",
    "prettier": "3.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rolldown": "1.0.0-rc.13",
    "solid-js": "1.9.12",
    "tikki": "3.0.2",
    "tsdown": "0.21.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vitepress": "1.6.4",
    "vitest": "4.1.2",
    "vitest-browser-react": "2.1.0",
    "vitest-browser-solid": "1.0.1",
    "vite-plugin-solid": "2.11.11",
    "vue": "3.5.32"
  },
  "overrides": {
    "esbuild": "0.27.5"
  }
}
