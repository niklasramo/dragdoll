{
  "name": "dragdoll-solid",
  "version": "1.0.0",
  "description": "SolidJS wrapper for DragDoll drag-and-drop system.",
  "keywords": [
    "drag",
    "drop",
    "dnd",
    "draggable",
    "droppable",
    "solid",
    "solid-js"
  ],
  "license": "MIT",
  "author": {
    "name": "Niklas Rämö",
    "email": "inramo@gmail.com",
    "url": "https://github.com/niklasramo"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/niklasramo/dragdoll.git",
    "directory": "packages/dragdoll-solid"
  },
  "homepage": "https://niklasramo.github.io/dragdoll/solid/",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./dnd-observer-context": "./dist/dnd-observer-context.js",
    "./drag-preview": "./dist/drag-preview.js",
    "./use-dnd-observer": "./dist/use-dnd-observer.js",
    "./use-dnd-observer-callback": "./dist/use-dnd-observer-callback.js",
    "./use-dnd-observer-context": "./dist/use-dnd-observer-context.js",
    "./use-drag-preview": "./dist/use-drag-preview.js",
    "./use-draggable": "./dist/use-draggable.js",
    "./use-draggable-auto-scroll": "./dist/use-draggable-auto-scroll.js",
    "./use-draggable-callback": "./dist/use-draggable-callback.js",
    "./use-draggable-drag": "./dist/use-draggable-drag.js",
    "./use-droppable": "./dist/use-droppable.js",
    "./use-keyboard-motion-sensor": "./dist/use-keyboard-motion-sensor.js",
    "./use-keyboard-sensor": "./dist/use-keyboard-sensor.js",
    "./use-pointer-sensor": "./dist/use-pointer-sensor.js",
    "./use-sensor-callback": "./dist/use-sensor-callback.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "prepublishOnly": "npm run build",
    "prettier:check": "prettier --check --no-error-on-unmatched-pattern \"./**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "prettier:write": "prettier --write --no-error-on-unmatched-pattern \"./**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "ts:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "dragdoll": "^1.0.0",
    "solid-js": "^1.9.0"
  }
}
