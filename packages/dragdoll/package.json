{
  "name": "dragdoll",
  "version": "0.12.0",
  "description": "Modular and extensible drag & drop system.",
  "keywords": [
    "drag",
    "drop",
    "dnd",
    "draggable",
    "droppable"
  ],
  "license": "MIT",
  "author": {
    "name": "Niklas Rämö",
    "email": "inramo@gmail.com",
    "url": "https://github.com/niklasramo"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/niklasramo/dragdoll.git",
    "directory": "packages/dragdoll"
  },
  "homepage": "https://niklasramo.github.io/dragdoll/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./auto-scroll": "./dist/auto-scroll.js",
    "./dnd-observer": "./dist/dnd-observer.js",
    "./dnd-observer/advanced-collision-detector": "./dist/dnd-observer/advanced-collision-detector.js",
    "./dnd-observer/collision-detector": "./dist/dnd-observer/collision-detector.js",
    "./draggable": "./dist/draggable.js",
    "./draggable/helpers/create-touch-delay-predicate": "./dist/draggable/helpers/create-touch-delay-predicate.js",
    "./draggable/modifiers/containment": "./dist/draggable/modifiers/containment.js",
    "./draggable/modifiers/snap": "./dist/draggable/modifiers/snap.js",
    "./draggable/plugins/auto-scroll": "./dist/draggable/plugins/auto-scroll.js",
    "./droppable": "./dist/droppable.js",
    "./sensors": "./dist/sensors.js",
    "./sensors/base": "./dist/sensors/base.js",
    "./sensors/base-motion": "./dist/sensors/base-motion.js",
    "./sensors/keyboard": "./dist/sensors/keyboard.js",
    "./sensors/keyboard-motion": "./dist/sensors/keyboard-motion.js",
    "./sensors/pointer": "./dist/sensors/pointer.js",
    "./singletons/auto-scroll": "./dist/singletons/auto-scroll.js",
    "./singletons/ticker": "./dist/singletons/ticker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "prepublishOnly": "npm run build",
    "prettier:check": "prettier --check --no-error-on-unmatched-pattern \"./**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "prettier:write": "prettier --write --no-error-on-unmatched-pattern \"./**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "ts:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "eventti": "^4.0.3",
    "mezr": "^1.1.0",
    "tikki": "^3.0.2"
  }
}
